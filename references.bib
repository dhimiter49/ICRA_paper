	note = {ISSN: 2474-2325},
	keywords = {Collision avoidance, Robot sensing systems, Training, Mobile robots, Trajectory, Standards, System integration},
	pages = {144--149},
	file = {Full Text PDF:/home/dhimiter/Zotero/storage/ILPQWYIF/Niu et al. - 2021 - Accelerated Sim-to-Real Deep Reinforcement Learning Learning Collision Avoidance from Human Player.pdf:application/pdf},
