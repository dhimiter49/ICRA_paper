	year = {2022},
	keywords = {Collision avoidance, Reinforcement learning, Sensors, deep reinforcement learning, machine learning, Unmanned aerial vehicles, Industries, multiaccess-edge computing (MEC), Regulation, unmanned aerial vehicles (UAVs), Vehicular ad hoc networks},
	pages = {4015--4030},
	file = {Full Text:/home/dhimiter/Zotero/storage/ADMCNT5Q/Ouahouah et al. - 2022 - Deep-Reinforcement-Learning-Based Collision Avoida.pdf:application/pdf},
}

@article{wang_collision_2023,
