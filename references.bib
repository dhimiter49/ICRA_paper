	keywords = {autonomous vehicle obstacle avoidance, path planning, Rapidly Exploring Random Trees},
	pages = {2244},
	file = {Full Text:/home/dhimiter/Zotero/storage/HPSSFLLH/Yang and Lin - 2021 - Development of an Improved Rapidly Exploring Rando.pdf:application/pdf},
}

@article{han_reinforcement_2022,
	title = {Reinforcement {Learned} {Distributed} {Multi}-{Robot} {Navigation} {With} {Reciprocal} {Velocity} {Obstacle} {Shaped} {Rewards}},
	volume = {7},
